{
  "manifest_version": 3,
  "name": "梨花下载器 - 浏览器会话",
  "version": "1.0.0",
  "description": "将当前网站的登录状态加密保存到本机梨花下载器。",
  "key": "",
  "permissions": [
    "cookies",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "梨花下载器",
    "default_popup": "popup.html"
  }
}
